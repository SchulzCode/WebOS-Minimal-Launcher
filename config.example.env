# Copy to config.env (git-ignored) and adjust. Used by scripts/rebuild-all.sh and tools/*.
# Nothing secret belongs in here: credentials stay on the TV / server, never in this repo.

# the TV (rooted webOS with Homebrew Channel, SSH enabled in its settings)
TV_IP=192.168.1.50
TV_SSH_KEY=$HOME/.ssh/id_rsa
# optional: a separate known_hosts file for the TV
#TV_KNOWN_HOSTS=$HOME/.ssh/tv_known_hosts

# this computer as the TV sees it (the TV downloads the .ipk from here; detected automatically if empty)
#PC_IP=192.168.1.10
PC_HTTP_PORT=1759

# webOS CLI used for packaging: ares-package (npm i -g @webos-tools/cli)
ARES_PACKAGE=ares-package

# only for server/launcher-feed/deploy.sh (optional Sonarr/Radarr strip): SSH login + folder for the compose project
#SERVER_SSH=user@192.168.1.20
#SERVER_KEY=$HOME/.ssh/id_ed25519
#SERVER_DIR=/home/user/launcher-feed
#FEED_BIND=192.168.1.20        # the server's LAN address the feed listens on
#ARR_NETWORK=arr                # docker network of the Sonarr/Radarr containers
# the launcher then reads the feed from http://FEED_BIND:8091/feed - set VITE_FEED_URL in app/.env.local (see README)
# Jellyfin Native can delete a film or a whole series through Sonarr/Radarr via the feed (Jellyfin administrators only;
# Jellyfin must be reachable from the feed container, see server/launcher-feed/docker-compose.yml)
#FEED_ALLOW_DELETE=1
